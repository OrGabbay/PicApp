# Required: secret used to sign login tokens (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Matches the database in docker-compose.yml (change the password in both places for anything
# other than local development)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/picapp_db

# Only needed when deploying:
# Public address of this backend, used in URLs of saved images
# PUBLIC_BACKEND_URL=https://api.picapp.example.com
# Comma-separated list of frontend origins allowed to call the API
# CORS_ORIGINS=https://picapp.example.com

# Optional: Pollinations token for higher free-engine limits (register at https://enter.pollinations.ai).
# Without it, the whole server shares about one free image every 45 seconds.
# POLLINATIONS_TOKEN=

# Optional: newer model versions for the paid engines and prompt enhancement
# OPENAI_IMAGE_MODEL=gpt-image-2
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_PRO_IMAGE_MODEL=gemini-3-pro-image
# FLUX_MODEL=flux-2-pro-preview
# OPENAI_TEXT_MODEL=gpt-4o-mini
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# POLLINATIONS_DEFAULT_MODEL=black-forest-labs/flux.2-klein-4b
