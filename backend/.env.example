# Optional: your AI provider key (Anthropic sk-ant-..., OpenAI sk-proj-..., Google AIza..., Groq gsk_...).
# Leave empty to use the free image engine.
ANTHROPIC_API_KEY=

# Required: secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Matches the database in docker-compose.yml
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/picapp_db
