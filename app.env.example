# Settings for running PicApp with run.bat / run.sh (docker-compose.app.yml).
# The run script copies this file to app.env on first start and fills in the two secrets
# with fresh random values. Edit app.env (never this file), then restart PicApp.

# Generated automatically. Don't change them after the first start: the database keeps
# the password it was created with, and a new JWT secret logs everyone out.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Optional but recommended: a free Pollinations token (create an account at
# https://enter.pollinations.ai). Without it, the free engine allows only about one image
# every 45 seconds; with it, images are faster and better.
POLLINATIONS_TOKEN=

# Optional: email server for "Forgot your password?" emails. Without it, reset links are
# written to the app log instead (see them with: run logs).
# Example for Gmail (needs an app password: https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password
#   SMTP_FROM=PicApp <you@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
