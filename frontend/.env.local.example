# Copy this file to .env.local and adjust if your backend runs elsewhere.
# Never commit .env.local to source control.

# Where the Next.js server reaches the FastAPI backend (server-side only)
BACKEND_URL=http://127.0.0.1:8000

# Public address of the backend that browsers load saved images from (used in the CSP header)
PUBLIC_BACKEND_URL=http://localhost:8000

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For (nginx, Vercel, ...),
# so the backend can rate-limit per visitor. Never enable it when Next.js faces the internet directly.
# TRUST_PROXY_HEADERS=true
